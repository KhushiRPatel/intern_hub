# Environment Variables Template
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# ⚠️  NEVER commit .env.local to Git — it is already in .gitignore

# ── Hasura GraphQL Engine ─────────────────────────────────────────────────────
# URL of your running Hasura instance
NEXT_PUBLIC_HASURA_ENDPOINT=http://localhost:8080/v1/graphql

# Hasura admin secret — must match HASURA_GRAPHQL_ADMIN_SECRET in docker-compose.yml
HASURA_ADMIN_SECRET=myadminsecret

# ── JWT Auth ──────────────────────────────────────────────────────────────────
# Must be at least 32 characters long
# Must match HASURA_GRAPHQL_JWT_SECRET.key in docker-compose.yml
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# true  → In-memory + localStorage only (PostgreSQL seed data will NOT appear)
# false → Use PostgreSQL via Hasura (required to see seed.sql / real DB rows)
NEXT_PUBLIC_DEMO_MODE=false

NEXT_PUBLIC_CHATBOT_API_URL=http://localhost:8000

# ── App URL (used in password-reset links) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── SMTP Email ────────────────────────────────────────────────────────────────
# Leave empty → Ethereal test mode (browser preview URL returned, no real email)
# Fill in   → Real SMTP (Gmail example shown below)
#
# Gmail setup:
#   1. Enable 2FA on Google account
#   2. Create App Password at https://myaccount.google.com/apppasswords
#   3. Use the 16-char App Password as SMTP_PASS (no spaces)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=InternMS <your-email@gmail.com>